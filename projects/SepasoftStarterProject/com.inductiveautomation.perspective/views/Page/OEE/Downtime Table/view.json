{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "mesObjectSelector"
        },
        "type": "mes.production.mesObjectSelector",
        "position": {
          "basis": "50px"
        },
        "props": {
          "displayText": "Line / Cell",
          "style": {
            "margin": "4px 6px",
            "overflow": "visible"
          },
          "includeMESLineObjects": true,
          "includeMESLineCellGroupObjects": true,
          "includeMESLineCellObjects": true
        }
      },
      {
        "meta": {
          "name": "flx_dates"
        },
        "type": "ia.container.flex",
        "position": {
          "basis": "60px"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "10px",
            "alignItems": "center"
          }
        },
        "children": [
          {
            "meta": {
              "name": "dt_start"
            },
            "type": "ia.input.date-time-input",
            "position": {
              "basis": "220px"
            },
            "props": {
              "style": {
                "margin": "4px 6px"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "expression": "dateArithmetic(now(0), -1, \"day\")"
                  },
                  "type": "expr"
                }
              }
            }
          },
          {
            "meta": {
              "name": "dt_end"
            },
            "type": "ia.input.date-time-input",
            "position": {
              "basis": "220px"
            },
            "props": {
              "style": {
                "margin": "4px 6px"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "expression": "now(0)"
                  },
                  "type": "expr"
                }
              }
            }
          }
        ]
      },
      {
        "meta": {
          "name": "downtimeTable"
        },
        "type": "mes.oee.downtimeTable",
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.equipmentPath": {
            "binding": {
              "config": {
                "path": "../mesObjectSelector.props.selectedMESObject.equipmentPath"
              },
              "type": "property"
            }
          },
          "props.startDate": {
            "binding": {
              "config": {
                "path": "../flx_dates/dt_start.props.value"
              },
              "type": "property"
            }
          },
          "props.endDate": {
            "binding": {
              "config": {
                "path": "../flx_dates/dt_end.props.value"
              },
              "type": "property"
            }
          }
        }
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
