{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "flx_header"
        },
        "type": "ia.container.flex",
        "position": {
          "basis": "50px"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "10px",
            "alignItems": "center"
          }
        },
        "children": [
          {
            "meta": {
              "name": "mesObjectSelector"
            },
            "type": "mes.production.mesObjectSelector",
            "position": {
              "basis": "340px"
            },
            "props": {
              "displayText": "Equipment",
              "style": {
                "margin": "4px 6px",
                "overflow": "visible"
              },
              "includeMESEnterpriseObjects": true,
              "includeMESSiteObjects": true,
              "includeMESAreaObjects": true,
              "includeMESLineObjects": true,
              "includeMESLineCellObjects": true
            }
          },
          {
            "meta": {
              "name": "dt_begin"
            },
            "type": "ia.input.date-time-input",
            "position": {
              "basis": "220px"
            },
            "props": {
              "style": {
                "margin": "4px 6px"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "expression": "dateArithmetic(now(0), -7, \"day\")"
                  },
                  "type": "expr"
                }
              }
            }
          },
          {
            "meta": {
              "name": "dt_end"
            },
            "type": "ia.input.date-time-input",
            "position": {
              "basis": "220px"
            },
            "props": {
              "style": {
                "margin": "4px 6px"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "expression": "now(0)"
                  },
                  "type": "expr"
                }
              }
            }
          }
        ]
      },
      {
        "meta": {
          "name": "scoVarianceViewer"
        },
        "type": "mes.recipe.scoVarianceViewer",
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.equipmentPathFilter": {
            "binding": {
              "config": {
                "path": "../flx_header/mesObjectSelector.props.selectedMESObject.equipmentPath"
              },
              "type": "property"
            }
          },
          "props.beginDate": {
            "binding": {
              "config": {
                "path": "../flx_header/dt_begin.props.value"
              },
              "type": "property"
            }
          },
          "props.endDate": {
            "binding": {
              "config": {
                "path": "../flx_header/dt_end.props.value"
              },
              "type": "property"
            }
          }
        }
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
