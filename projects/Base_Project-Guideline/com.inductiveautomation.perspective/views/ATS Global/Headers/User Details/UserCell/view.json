{
  "custom": {},
  "params": {
    "data": [
      ""
    ],
    "header": ""
  },
  "propConfig": {
    "params.data": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.header": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 58,
      "width": 194
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.header"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "alignVertical": "bottom",
          "style": {
            "borderBottomColor": "var(--neutral-30)",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "0.5px",
            "classes": "ats-global/headers/secondary-labels"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Body"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.data"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027 - \u0027.join(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignVertical": "top",
          "style": {
            "classes": "ats-global/headers/primary-labels",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "visible"
      }
    },
    "type": "ia.container.flex"
  }
}