{
  "custom": {},
  "params": {
    "title": "Numeric Value"
  },
  "propConfig": {
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 210
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "fl-label",
            "zIndex": 999
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tval \u003d self.props.value\n\tif val \u003d\u003d \u0027\u0027:\n\t    self.getSibling(\"Title\").props.style.classes \u003d \"fl-label\""
              },
              "scope": "G",
              "type": "script"
            }
          },
          "dom": {
            "onBlur": {
              "config": {
                "script": "\tval \u003d self.props.value\n\tif val \u003d\u003d \u0027\u0027:\n\t    self.getSibling(\"Title\").props.style.classes \u003d \"fl-label\""
              },
              "scope": "G",
              "type": "script"
            },
            "onFocus": {
              "config": {
                "script": "\tself.getSibling(\"Title\").props.style.classes \u003d \"fl-label fl-label--active\""
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "NumericEntryField"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "props": {
          "style": {
            "classes": "fl-input"
          }
        },
        "type": "ia.input.numeric-entry-field"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "margin": "2px",
        "overflow": "visible"
      }
    },
    "type": "ia.container.flex"
  }
}