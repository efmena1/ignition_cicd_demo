{
  "custom": {},
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\t\n\t\n\t\n\tdef cleanIcon(icon):\n\t    # Limpia color y opacity que haya quedado guardado del estado bloqueado\n\t    if not icon:\n\t        return None\n\t    cleaned \u003d dict(icon)\n\t    cleaned.pop(\u0027color\u0027, None)\n\t    if \u0027style\u0027 in cleaned:\n\t        style \u003d dict(cleaned[\u0027style\u0027])\n\t        style.pop(\u0027opacity\u0027, None)\n\t        if style:\n\t            cleaned[\u0027style\u0027] \u003d style\n\t        else:\n\t            cleaned.pop(\u0027style\u0027, None)\n\t    return cleaned if cleaned else None\n\t\n\tdef applyAccessStyle(items):\n\t\tif self.session.props.auth.authenticated:\n\t\t\tuserRoles \u003d self.session.props.auth.user.roles\n\t\telse:\n\t\t\tuserRoles \u003d []\n\t\t\n\t\tresult \u003d []\n\t\tfor item in items:\n\t\t    newItem \u003d dict(item)\n\t\t    accessRoles \u003d item.get(\u0027data\u0027, {}).get(\u0027accessRoles\u0027, [])\n\t\t    hasAccess \u003d not accessRoles or any(role in userRoles for role in accessRoles)\n\t\t\n\t\t    if hasAccess:\n\t\t\t\tlabel \u003d item.get(\u0027label\u0027, \u0027\u0027)\n\t\t\t\tif label.startswith(\u0027🔒 \u0027):\n\t\t\t\t    newItem[\u0027label\u0027] \u003d label[3:]\n\t\t        # Tiene acceso: limpiar cualquier estilo bloqueado que haya quedado guardado\n\t\t\t\tcurrentIcon \u003d item.get(\u0027icon\u0027, None)\n\t\t\t\tcleaned \u003d cleanIcon(currentIcon)\n\t\t\t\tif cleaned:\n\t\t\t\t    newItem[\u0027icon\u0027] \u003d cleaned\n\t\t\t\telif \u0027icon\u0027 in newItem:\n\t\t\t\t    newItem.pop(\u0027icon\u0027, None)\n\t\t    else:\n\t\t    \tnewItem[\u0027label\u0027] \u003d \u0027🔒 \u0027 + item.get(\u0027label\u0027, \u0027\u0027)\n\t\t        # Sin acceso: aplicar estilo bloqueado\n\t\t        currentIcon \u003d item.get(\u0027icon\u0027, None)\n\t\t        if currentIcon and currentIcon.get(\u0027path\u0027):\n\t\t            newItem[\u0027icon\u0027] \u003d {\n\t\t                \u0027path\u0027: currentIcon.get(\u0027path\u0027),\n\t\t                \u0027color\u0027: \u0027var(--neutral-30)\u0027,\n\t\t                \u0027style\u0027: {\n\t\t                   \n\t\t                }\n\t\t            }\n\t\t        else:\n\t\t            newItem[\u0027icon\u0027] \u003d {\n\t\t                \u0027color\u0027: \u0027var(--neutral-30)\u0027,\n\t\t                \u0027style\u0027: {\n\t\t                  \n\t\t                }\n\t\t            }\n\t\t\n\t\t    if item.get(\u0027items\u0027):\n\t\t        newItem[\u0027items\u0027] \u003d applyAccessStyle(item[\u0027items\u0027])\n\t\t    result.append(newItem)\n\t\treturn result\n\t\n\titems \u003d self.getChild(\"root\").getChild(\"Tree\").props.items\t\n\tself.getChild(\"root\").getChild(\"Tree\").custom.allItems \u003d items\n\t\n\tself.getChild(\"root\").getChild(\"Tree\").props.items \u003d applyAccessStyle(items)\n\t\n\t\n\t\n\t"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
