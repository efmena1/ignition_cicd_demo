          {
            "events": {
              "component": {
                "onPropertyChange": {
                  "config": {
                    "script": "# Obtiene el texto de búsqueda actual\nsearchText \u003d self.props.text.lower() if self.props.text else \u0027\u0027\n\ndef filterItems(items, search):\n    if not search:\n        return items\n    result \u003d []\n    for item in items:\n        children \u003d filterItems(item.get(\u0027items\u0027, []), search)\n        label \u003d item.get(\u0027label\u0027, \u0027\u0027).lower()\n        if search in label or children:\n            newItem \u003d dict(item)\n            newItem[\u0027items\u0027] \u003d children\n            newItem[\u0027expanded\u0027] \u003d True if children else item.get(\u0027expanded\u0027, False)\n            result.append(newItem)\n    return result\n\n# Accede al árbol y filtra\ntree \u003d self.parent.getChild(\u0027Tree\u0027)\noriginalItems \u003d self.parent.custom.get(\u0027allItems\u0027, None)\n\nif originalItems is None:\n    # Primera vez: guarda los items originales en custom del contenedor\n    self.parent.custom[\u0027allItems\u0027] \u003d list(tree.props.items)\n    originalItems \u003d self.parent.custom[\u0027allItems\u0027]\n\ntree.props.items \u003d filterItems(list(originalItems), searchText)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "SearchField"
            },
            "position": {
              "basis": "38px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "onChange": {
                  "enabled": null,
                  "script": "\tsearchText \u003d currentValue.value.lower() if currentValue.value else \"\"\n\t\n\tdef fuzzyMatch(label, search):\n\t    if not search:\n\t        return True\n\t    if search in label:\n\t        return True\n\t    it \u003d iter(label)\n\t    return all(c in it for c in search)\n\t\n\tdef filterItems(items, search):\n\t    if not search:\n\t        return items\n\t    result \u003d []\n\t    for item in items:\n\t        label \u003d item.get(\u0027label\u0027, \u0027\u0027).lower()\n\t        if fuzzyMatch(label, search):\n\t            # El padre coincide: incluir con TODOS sus hijos intactos\n\t            newItem \u003d dict(item)\n\t            newItem[\u0027expanded\u0027] \u003d True\n\t            result.append(newItem)\n\t        else:\n\t            # El padre no coincide: revisar si algún hijo coincide\n\t            children \u003d filterItems(item.get(\u0027items\u0027, []), search)\n\t            if children:\n\t                newItem \u003d dict(item)\n\t                newItem[\u0027items\u0027] \u003d children\n\t                newItem[\u0027expanded\u0027] \u003d True\n\t                result.append(newItem)\n\t    return result\n\t\n\ttree \u003d self.parent.parent.getChild(\"Tree\")\n\t\n\tif not self.parent.parent.getChild(\"Tree\").custom.allItems:\n\t    self.parent.parent.getChild(\"Tree\").custom.allItems \u003d system.util.jsonDecode(\n\t        system.util.jsonEncode(tree.props.items)\n\t    )\n\t\n\toriginalItems \u003d self.parent.parent.getChild(\"Tree\").custom.allItems\n\tself.parent.parent.getChild(\"Tree\").props.items \u003d filterItems(list(originalItems), searchText)"
                }
              }
            },
