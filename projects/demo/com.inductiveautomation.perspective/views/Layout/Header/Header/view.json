{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 1000
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "id": "Navigation",
                "type": "toggle"
              },
              "scope": "C",
              "type": "dock"
            }
          }
        },
        "meta": {
          "name": "Menu"
        },
        "position": {
          "basis": "30px"
        },
        "props": {
          "path": "material/menu",
          "style": {
            "classes": "Components/Icons/icon-action"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "page": "/"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "name": "ATS-Logo"
        },
        "position": {
          "basis": "90px",
          "shrink": 0
        },
        "props": {
          "fit": {
            "mode": "contain"
          },
          "source": "data:image/png;base64,\u003d\u003d",
          "style": {
            "padding": "5px"
          }
        },
        "type": "ia.display.image"
      },
      {
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tx \u003d event[\u0027pageX\u0027]\n\ty \u003d event[\u0027pageY\u0027]\n\t\n\tposition \u003d {\n\t\t\u0027left\u0027: x - 220,\n\t\t\u0027top\u0027: 50\n\t}\n\t\n\t\n\tsystem.perspective.openPopup(\n\t\t\u0027Settings\u0027, \n\t\tview \u003d \u0027Layout/Header/Popups/Settings\u0027,\n\t\tshowCloseIcon \u003d False,\n\t\tmodal \u003d True,\n\t\toverlayDismiss \u003d True,\n\t\tdraggable \u003d False,\n\t\tposition \u003d position,\n\t\tbackgroundDimissible \u003d False\n\t)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Settings"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/more_vert",
              "style": {
                "alignSelf": "center",
                "classes": "Components/Icons/icon-action"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "User"
                },
                "position": {
                  "basis": "30px",
                  "shrink": 0
                },
                "props": {
                  "path": "material/person"
                },
                "type": "ia.display.icon"
              },
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({session.props.auth.authenticated},{session.props.auth.user.userName}, \"#auth.user.login\")"
                      },
                      "type": "expr"
                    }
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tif not self.session.props.auth.authenticated:\n\t    system.perspective.login()\n\t    return\n\t\n\tviewportWidth \u003d max(1, int(self.page.props.dimensions.viewport.width))\n\tviewportHeight \u003d max(1, int(self.page.props.dimensions.viewport.height))\n\trightOffset \u003d min(16, max(0, (viewportWidth - 1) // 2))\n\tbottomMargin \u003d min(16, max(0, (viewportHeight - 1) // 2))\n\ttopOffset \u003d min(64, max(0, viewportHeight - bottomMargin - 1))\n\t\n\tavailableWidth \u003d max(1, viewportWidth - 2 * rightOffset)\n\ttargetWidth \u003d max(330, min(int(viewportWidth * 0.35), 380))\n\tpopupWidth \u003d min(targetWidth, availableWidth)\n\tpopupHeight \u003d min(520, max(1, viewportHeight - topOffset - bottomMargin))\n\t\n\tsystem.perspective.togglePopup(\n\t    id\u003d\"userdrawer\",\n\t    view\u003d\"Layout/Header/Popups/UserDrawer\",\n\t    params\u003d{},\n\t    title\u003d\"\",\n\t    position\u003d{\"top\": topOffset, \"right\": rightOffset, \"width\": popupWidth, \"height\": popupHeight},\n\t    showCloseIcon\u003dFalse,\n\t    draggable\u003dFalse,\n\t    resizable\u003dFalse,\n\t    modal\u003dTrue,\n\t    overlayDismiss\u003dTrue,\n\t    viewportBound\u003dTrue\n\t)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Controls"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "justify": "flex-end",
              "style": {
                "alignSelf": "center",
                "classes": "Components/Icons/icon-button",
                "gap": "8px",
                "padding": "0 5px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "Settings"
        },
        "position": {
          "shrink": 0
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "borderBottom": "solid 1px var(--neutral-20)",
        "gap": "10px",
        "padding": "0 10px"
      }
    },
    "type": "ia.container.flex"
  }
}