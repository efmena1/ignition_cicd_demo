            "meta": {
              "name": "SessionTime"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!isNull({session.props.auth.user.timestamp})"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "locale": "{session.props.locale}",
                      "timeZoneId": "{session.props.timeZoneId}",
                      "timestamp": "{session.props.auth.user.timestamp}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\tif value[\"timestamp\"] is None:\n\t    return u\"\"\n\tfrom java.util import Locale, TimeZone\n\tfrom java.text import DateFormat\n\tlocale \u003d Locale.forLanguageTag(unicode(value[\"locale\"] or \"en\").replace(\"_\", \"-\"))\n\tformatter \u003d DateFormat.getTimeInstance(DateFormat.MEDIUM, locale)\n\tformatter.setTimeZone(TimeZone.getTimeZone(value[\"timeZoneId\"]))\n\treturn u\"%s: %s\" % (system.util.translate(\"#session.login.time\", value[\"locale\"]), formatter.format(value[\"timestamp\"]))\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
