                  },
                  "transforms": [
                    {
                      "code": "\treturn \"%s: %s\"%(system.util.translate(\"#common.project\", value), system.util.getProjectName())",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
