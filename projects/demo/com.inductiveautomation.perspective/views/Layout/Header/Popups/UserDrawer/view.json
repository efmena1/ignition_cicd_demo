{
  "custom": {},
  "params": {
    "userSource": "default"
  },
  "propConfig": {
    "custom.userInfo": {
      "binding": {
        "config": {
          "struct": {
            "authenticated": "{session.props.auth.authenticated}",
            "userSource": "{view.params.userSource}",
            "username": "{session.props.auth.user.userName}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tfrom java.lang import Exception as JavaException\n\t\n\tdef empty(status):\n\t    return {\"emails\": [], \"phones\": [], \"badge\": u\"\", \"schedule\": u\"\", \"status\": status}\n\t\n\tdef clean(item):\n\t    return unicode(item).strip() if item is not None else u\"\"\n\t\n\tif not value[\"authenticated\"] or not clean(value[\"username\"]):\n\t    return empty(\"unavailable\")\n\t\n\ttry:\n\t    user \u003d system.user.getUser(value[\"userSource\"], value[\"username\"])\n\t    if user is None:\n\t        system.util.getLogger(\"UserDrawer\").warn(\"User information unavailable: user lookup returned no result.\")\n\t        return empty(\"unavailable\")\n\t    result \u003d empty(\"ready\")\n\t    seenEmails \u003d set()\n\t    seenPhones \u003d set()\n\t    for contact in user.getContactInfo() or []:\n\t        kind \u003d clean(contact.contactType).lower()\n\t        text \u003d clean(contact.value)\n\t        if not text:\n\t            continue\n\t        if kind \u003d\u003d \"email\" and text.lower() not in seenEmails:\n\t            result[\"emails\"].append(text)\n\t            seenEmails.add(text.lower())\n\t        elif kind in (\"phone\", \"sms\") and text not in seenPhones:\n\t            result[\"phones\"].append(text)\n\t            seenPhones.add(text)\n\t    result[\"badge\"] \u003d clean(user.get(\"badge\"))\n\t    result[\"schedule\"] \u003d clean(user.get(\"schedule\"))\n\t    return result\n\texcept (Exception, JavaException):\n\t    # Provider exceptions can contain personal data; log a fixed message only.\n\t    system.util.getLogger(\"UserDrawer\").warn(\"User information unavailable: user source lookup failed.\")\n\t    return empty(\"unavailable\")\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": false
    },
    "params.userSource": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 520,
      "width": 380
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Avatar"
                },
                "position": {
                  "basis": "56px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "struct": {
                          "authenticated": "{session.props.auth.authenticated}",
                          "firstName": "{session.props.auth.user.firstName}",
                          "lastName": "{session.props.auth.user.lastName}",
                          "username": "{session.props.auth.user.userName}"
                        },
                        "waitOnAll": true
                      },
                      "transforms": [
                        {
                          "code": "\tif not value[\"authenticated\"]:\n\t    return u\"\"\n\tfirst \u003d unicode(value[\"firstName\"] or u\"\").strip()\n\tlast \u003d unicode(value[\"lastName\"] or u\"\").strip()\n\tinitials \u003d first[:1] + last[:1]\n\treturn (initials or unicode(value[\"username\"] or u\"\").strip()[:2]).upper()\n",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "user-drawer-avatar"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "children": [
                  {
                    "meta": {
                      "name": "Name"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "struct": {
                              "authenticated": "{session.props.auth.authenticated}",
                              "firstName": "{session.props.auth.user.firstName}",
                              "lastName": "{session.props.auth.user.lastName}",
                              "username": "{session.props.auth.user.userName}"
                            },
                            "waitOnAll": true
                          },
                          "transforms": [
                            {
                              "code": "\tif not value[\"authenticated\"]:\n\t    return u\"\"\n\tfullName \u003d u\" \".join(unicode(value[key]).strip() for key in (\"firstName\", \"lastName\") if value[key] and unicode(value[key]).strip())\n\treturn fullName or unicode(value[\"username\"] or u\"\").strip()\n",
                              "type": "script"
                            }
                          ],
                          "type": "expr-struct"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "user-drawer-name"
                      }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "children": [
                      {
                        "meta": {
                          "name": "Roles"
                        },
                        "position": {
                          "grow": 1
                        },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "config": {
                                "path": "session.props.auth.user.roles"
                              },
                              "transforms": [
                                {
                                  "code": "\treturn u\", \".join(unicode(role).strip() for role in (value or []) if role and unicode(role).strip())\n",
                                  "type": "script"
                                }
                              ],
                              "type": "property"
                            }
                          }
                        },
                        "props": {
                          "style": {
                            "classes": "user-drawer-chip"
                          }
                        },
                        "type": "ia.display.label"
                      }
                    ],
                    "meta": {
                      "name": "RoleRow"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "propConfig": {
                      "position.display": {
                        "binding": {
                          "config": {
                            "expression": "len({./Roles.props.text}) \u003e 0"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "gap": 6
                      },
                      "wrap": "wrap"
                    },
                    "type": "ia.container.flex"
                  }
                ],
