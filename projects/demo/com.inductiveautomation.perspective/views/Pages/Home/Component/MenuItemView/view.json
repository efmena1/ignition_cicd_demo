{
  "custom": {},
  "params": {
    "description": "Hand Tipping List View",
    "enabled": false,
    "icon-path": "material/account_balance_wallet",
    "title": "Hand Tipping"
  },
  "propConfig": {
    "params.description": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon-path": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 130,
      "width": 211
    },
    "enabled": true
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.borderBottom": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "solid 0.5px var(--neutral-30)",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "solid 0.5px #ff6c0c"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "var(--neutral-30)",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "var(--neutral-60)"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "alignVertical": "bottom",
          "style": {
            "classes": "layout/section/section__title",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "60px",
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "var(--neutral-30)",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "var(--neutral-50)"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.icon-path"
              },
              "type": "property"
            }
          },
          "props.style.filter": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "none",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "drop-shadow(1px 1px 1px rgba(0,0,0,0.6))"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "padding": "0px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label_1"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "var(--neutral-30)",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "var(--neutral-50)"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.description"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "alignVertical": "top",
          "style": {
            "fontSize": "11px",
            "lineHeight": "12px",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "path": "view.params.enabled"
          },
          "transforms": [
            {
              "fallback": "layout/home/menu-item__body--disabled",
              "inputType": "scalar",
              "mappings": [
                {
                  "input": true,
                  "output": "layout/home/menu-item__body"
                }
              ],
              "outputType": "scalar",
              "type": "map"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "backdropFilter": "blur(12px) saturate(140%)",
        "enabled": true,
        "overflow": "hidden",
        "webkitBackdropFilter": "blur(12px) saturate(140%)"
      }
    },
    "type": "ia.container.flex"
  }
}